*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Extra generated folders we're seeing in this project
ReimportCache/*
PipInstall/*

# macOS junk file
.DS_Store
# Additional generated files/folders seen in this project
CachedAssetRegistry/
ShaderAutogen/
ShaderDebugInfo/
Shaders/
UnrealBuildTool/
TEXTURE_*
*.ref

# Machine-specific settings files (auto-regenerated, not meant to be shared)
Config/CrashReportClient.ini
Config/*UserSettings.ini
CrashReportClient/
MacEditor/
WindowsEditor/
LinuxEditor/